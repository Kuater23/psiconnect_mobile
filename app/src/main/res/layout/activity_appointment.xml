<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/verde_oscuro"
    android:padding="5dp"
    tools:context=".patient.AppointmentActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/verde_oscuro">

        <!-- Imagen del Doctor -->
        <ImageView
            android:id="@+id/ImgApp"
            android:layout_width="0dp"
            android:layout_height="200dp"
            android:layout_marginStart="32dp"
            android:layout_marginTop="4dp"
            android:layout_marginEnd="32dp"
            android:background="#FFFFFF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:srcCompat="@tools:sample/avatars" />

        <!-- Nombre del Doctor -->
        <TextView
            android:id="@+id/txtAppName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="32dp"
            android:background="#FFFFFF"
            android:fontFamily="@font/baloo"
            android:padding="10dp"
            android:text="Nombre"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ImgApp" />

        <!-- Apellido del Doctor -->
        <TextView
            android:id="@+id/txtAppSurname"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:background="#FFFFFF"
            android:fontFamily="@font/baloo"
            android:padding="10dp"
            android:text="Apellido"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtAppName" />

        <!-- Fecha de Nacimiento del Doctor -->
        <TextView
            android:id="@+id/txtAppDob"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:background="#FFFFFF"
            android:fontFamily="@font/baloo"
            android:padding="10dp"
            android:text="Fecha de Nacimiento"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtAppSurname" />

        <!-- Especialidad del Doctor -->
        <TextView
            android:id="@+id/txtAppSpeciality"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="32dp"
            android:layout_marginTop="16dp"
            android:layout_marginEnd="32dp"
            android:background="#FFFFFF"
            android:fontFamily="@font/baloo"
            android:padding="10dp"
            android:text="Especialidad"
            android:textColor="#000000"
            android:textSize="20sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtAppDob" />

        <!-- Nota de la Cita -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/materialCardView"
            android:layout_width="0dp"
            android:layout_height="150dp"
            android:layout_margin="32dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/txtAppSpeciality"
            app:strokeColor="#000000"
            app:strokeWidth="2dp">

            <EditText
                android:id="@+id/editTxtAppNote"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:hint="Ingrese una nota..."
                android:fontFamily="@font/baloo"
                android:gravity="top"
                android:inputType="textMultiLine"
                android:maxLines="5"
                android:textColor="#000000"/>
        </com.google.android.material.card.MaterialCardView>

        <!-- Hora Seleccionada -->
        <TextView
            android:id="@+id/txtAppHour"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:background="#FFFFFF"
            android:fontFamily="@font/baloo"
            android:padding="5dp"
            android:text="Hora seleccionada"
            android:textAlignment="center"
            android:textColor="#000000"
            android:textSize="16sp"
            app:layout_constraintTop_toBottomOf="@id/materialCardView"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"/>

        <!-- Botón para Seleccionar Hora -->
        <ImageButton
            android:id="@+id/btnSelectHour"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="32dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/txtAppHour"
            app:layout_constraintStart_toStartOf="parent"
            app:srcCompat="@drawable/ic_appointment_hour"/>

        <!-- Botón para Seleccionar Fecha -->
        <ImageButton
            android:id="@+id/btnSelectDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="32dp"
            android:background="@android:color/transparent"
            app:layout_constraintTop_toBottomOf="@id/txtAppHour"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_appointment_date"/>

        <!-- Botón para Solicitar Cita -->
        <Button
            android:id="@+id/btnMakeApp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="32dp"
            android:text="Solicitar cita"
            android:textSize="18sp"
            app:layout_constraintTop_toBottomOf="@id/btnSelectHour"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:srcCompat="@drawable/ic_savebutton"/>
    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>
